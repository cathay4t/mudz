[main]
# Which UDP socket to listen
udp_bind = "127.0.0.1:53"
# Which TCP socket to listen (optional). DNS over TCP is required by
# RFC 7766: clients retry over TCP when a UDP reply is truncated (TC bit).
# Defaults to the same address as udp_bind.
# tcp_bind = "127.0.0.1:53"
# Maximum number of cache entries
max_cache_size = 4096
# Log level (trace, debug, info, warn, error)
log_level = "info"

[fallback]
# Send out DNS request to all nameservers simultaneously, and reply to user
# once got any valid reply
nameservers = ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query"]
disable_ipv6 = false

# To resovle DoH server's domain name, use these UDP nameservers only.
# Mandatory if DoH server is used.
[doh]
nameservers = ["223.5.5.5", "119.29.29.29"]
# Do not resolve DoH server's domain name with IPv6
disable_ipv6 = false
# Overall timeout in seconds for one DoH lookup, including retries
#timeout = 5
# Retries after the first DoH attempt
#retries = 1
# HTTP/2 keepalive ping interval in seconds (0 disables keepalive)
#keepalive_interval = 20
# Seconds to wait for a keepalive acknowledgement
#keepalive_timeout = 5
# Seconds an idle pooled DoH connection may stay open
#idle_timeout = 60

# Redirect user's request on these domains to specified nameservers instead of
# fallback ones
[group.google]
nameservers = ["8.8.8.8", "https://dns.google/dns-query"]
domains = [
    "google.com",
    "youtube.com",
]

[group.company]
nameservers = ["10.0.0.1"]
domains = [
    "fish-touching.net",
]
# Don't send AAAA queries to this nameserver
disable_ipv6 = true

# Return NXDOMAIN for these domains without sending any upstream query
# (useful for blocking domains)
[group.blocked]
nameservers = []
domains = [
    "ads.example.com",
]
